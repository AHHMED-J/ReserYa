# Copia este archivo como .env y llena lo que tengas. Lo que falte usa un modo de prueba.
DATABASE_URL=postgres://localhost:5432/reserya
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Google Cloud > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web)
# URI de redirección autorizada: http://localhost:4000/api/auth/google/callback
#                               http://localhost:4000/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe en modo de prueba (sk_test_...). Sin llave, el pago es simulado.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# smtp://usuario:clave@smtp.gmail.com:465 . Sin él, los correos salen en la consola.
SMTP_URL=
MAIL_FROM=ReserYa <no-reply@reserya.test>

JOBS_ENABLED=true
