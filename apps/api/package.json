{
  "name": "api",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "lint": "eslint .",
    "test": "NODE_ENV=test DATABASE_URL=${TEST_DATABASE_URL:-postgres://localhost:5432/reserya_test} node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed/index.js",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.js && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  }
}
